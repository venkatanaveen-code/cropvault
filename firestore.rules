rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==============================================================================
    // CropVault Security Rules - JNTUA Innovation Conclave Prototype
    // ==============================================================================
    // In production, integrate Firebase Authentication to restrict writes to verified
    // warehouse managers (e.g., request.auth != null && request.auth.token.role == 'manager').
    //
    // For this prototype demonstration, we allow public read and write access to the
    // 'crop_deposits' collection while enforcing basic data structure validation.
    // ==============================================================================

    match /crop_deposits/{depositId} {
      // Allow reading all crop records (for public lookup and receipt verification)
      allow read: if true;

      // Allow creating a crop record if essential fields are provided
      allow create: if request.resource.data.receiptId is string
                    && request.resource.data.farmerName is string
                    && request.resource.data.cropType is string
                    && request.resource.data.totalWeightKg is number
                    && request.resource.data.totalWeightKg > 0;

      // Allow updating and deleting records for manager demo administration
      allow update, delete: if true;
    }

    // Default deny for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
