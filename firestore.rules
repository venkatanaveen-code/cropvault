rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==============================================================================
    // CropVault Security Rules - JNTUA Innovation Conclave Prototype
    // ==============================================================================
    // Only the explicitly allowed warehouse account may access crop records.
    // ==============================================================================

    function isWarehouseUser() {
      return request.auth != null
             && request.auth.uid == 'REPLACE_WITH_WAREHOUSE_USER_UID';
    }

    match /crop_deposits/{depositId} {
      allow read: if isWarehouseUser();

      allow create: if isWarehouseUser()
                    && request.resource.data.receiptId is string
                    && request.resource.data.farmerName is string
                    && request.resource.data.cropType is string
                    && request.resource.data.totalWeightKg is number
                    && request.resource.data.totalWeightKg > 0;

      allow update, delete: if isWarehouseUser();
    }

    // Default deny for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
